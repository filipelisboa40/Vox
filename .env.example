# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Application ID from the Discord Developer Portal.
DISCORD_CLIENT_ID=

# Optional development server ID for guild-scoped command deployment.
DISCORD_GUILD_ID=

# YouTube Data API v3 key used for searches and video metadata.
YOUTUBE_API_KEY=

# Lavalink server with the youtube-source plugin enabled.
LAVALINK_URL=http://localhost:2333
LAVALINK_PASSWORD=change-me

# Optional ISO 3166-1 alpha-2 region used for search and availability checks.
YOUTUBE_REGION=

# Optional Pino log level, such as debug, info, warn, or error.
LOG_LEVEL=info
