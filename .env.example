# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Application ID from the Discord Developer Portal.
DISCORD_CLIENT_ID=

# Optional development server ID for guild-scoped command deployment.
DISCORD_GUILD_ID=

# Optional yt-dlp executable path. Leave empty when yt-dlp is available on PATH.
YT_DLP_PATH=

# Initial per-server playback volume from 0 through 100.
DEFAULT_VOLUME=10

# Disconnect after this many idle seconds. Use 0 to disable automatic disconnects.
IDLE_DISCONNECT_SECONDS=300

# Optional Pino log level, such as debug, info, warn, or error.
LOG_LEVEL=info
